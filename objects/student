class Student:
  all_slots = "900,930,1000,1030,1100,1130,1200,1230,1300,1330,1400,1430,1500,1530,1600,1630,1700,1730,1800,1830,1900,1930,2000,2030,2100,2130,2200,2230,2300,2330".split(',')
  days_of_the_week = 'Sun,Mon,Tue,Wed,Thu,Fri,Sat'.split(',')

  def __init__(self, course, email, name, availability):
    self.course = course
    self.email = email
    self.name = name
    self.availability = availability # dictionary
  
  def __repr__(self):
    return f"Student(name={self.name}, email={self.email})"

  def decode_day_schedule(day_sched_int): # i.e. value stored in availability
    """Converts the integer-based bitmask into a list of time slots"""
    slots = []
    for i,slot in enumerate(Student.all_slots):
      slot_val = 1 << i
      if day_sched_int & slot_val:
          slots.append(slot)
    return slots
  
  def student_schedule_string(self):
    """Returns a formatted string showingthe student's availability"""
    # result = self['student_name'] + ' on\n'
    result = f"{self.name} is available on \n"
    for day in Student.days_of_the_week:
        dic_key = f'{day}_s'
        if dic_key in self.availability:
            slots = Student.decode_day_schedule(self.availability[dic_key])
            result += f"{day}: {slots}\n"
        else:
           result += f" {day}: No availability"
    return result
  
